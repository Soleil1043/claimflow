# ========= 应用配置 =========
# 运行 profile：dev=本地降级（SQLite/Qdrant local mode/内存缓存，零容器） | prod=全量真实依赖
APP_PROFILE=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# ========= LLM（DeepSeek，OpenAI 兼容接口） =========
# 注意：deepseek-chat / deepseek-reasoner 旧别名已于 2026-07-24 退役，调用会报错
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-deepseek-api-key
# 主链路模型（意图识别/任务规划/工具调用/回答生成）
LLM_MODEL=deepseek-v4-flash
# 图片 OCR 专职模型（失败自动降级 Mock，见 D008）
LLM_VISION_MODEL=deepseek-v4-flash-vision-exp

# ========= PostgreSQL（prod profile 使用；dev 自动降级 SQLite） =========
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=claim
POSTGRES_PASSWORD=claimpass
POSTGRES_DB=claim_agent

# ========= Qdrant =========
# prod：连接 Qdrant 服务；dev：使用 local mode 本地文件（零容器）
QDRANT_URL=http://localhost:6333
QDRANT_LOCAL_PATH=./data/qdrant
QDRANT_COLLECTION=claim_rules

# ========= Redis（prod profile 使用；dev 自动降级内存缓存） =========
REDIS_URL=redis://localhost:6379/0

# ========= Embedding（BGE-M3，本地 sentence-transformers） =========
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# ========= 日志 =========
LOG_LEVEL=INFO
