# ========= 应用配置 =========
# 运行 profile：dev=本地降级（SQLite/Qdrant local mode/内存缓存，零容器） | prod=全量真实依赖
APP_PROFILE=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# ========= LLM（DeepSeek，OpenAI 兼容接口） =========
# 注意：deepseek-chat / deepseek-reasoner 旧别名已于 2026-07-24 退役，调用会报错
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-deepseek-api-key
# 主链路模型（意图识别/任务规划/工具调用/回答生成）
LLM_MODEL=deepseek-v4-flash
# 图片 OCR 专职模型（失败自动降级 Mock，见 D008）
LLM_VISION_MODEL=deepseek-v4-flash-vision-exp

# ========= PostgreSQL（prod profile 使用；dev 自动降级 SQLite） =========
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=claim
POSTGRES_PASSWORD=claimpass
POSTGRES_DB=claim_agent

# ========= Qdrant =========
# prod：连接 Qdrant 服务；dev：使用 local mode 本地文件（零容器）
QDRANT_URL=http://localhost:6333
QDRANT_LOCAL_PATH=./data/qdrant
QDRANT_COLLECTION=claim_rules

# ========= Redis（prod profile 使用；dev 自动降级内存缓存） =========
REDIS_URL=redis://localhost:6379/0

# ========= 工具结果缓存（T028） =========
# 幂等查询工具的结果缓存：prod=Redis / dev=进程内 TTL 字典
TOOL_CACHE_ENABLED=true
TOOL_CACHE_TTL_SECONDS=300
# 白名单（逗号分隔）：仅纯读查询工具，计算类/合规类不入缓存
TOOL_CACHE_TOOLS=policy_query,medical_record_query,diagnosis_matcher,claim_rule_rag,claim_status_query

# ========= 轮次 Token 预算（T029） =========
# 单轮对话总 token 上限；超限输出告警日志（不阻断）。0=不设预算
TURN_TOKEN_BUDGET=0

# ========= OTel 追踪（T039） =========
# 开关：true 时 OTLP 上报（需先起 tracing 栈：docker compose --profile tracing up -d）
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
# 采样率 0.0-1.0（ParentBased(TraceIdRatioBased)）
OTEL_SAMPLING_RATIO=1.0

# ========= 长期记忆（T034/T035） =========
# 会话摘要 + 关键实体向量化入独立 Qdrant collection（按 user_id payload 隔离）
MEMORY_ENABLED=true
# 每隔多少轮（用户消息数）更新一次该会话的记忆摘要
MEMORY_SUMMARY_EVERY_N_TURNS=3
QDRANT_MEMORY_COLLECTION=long_term_memory
# 读注入：新会话首轮检索历史记忆条数与相似度下限（低于阈值不注入）
MEMORY_TOP_K=2
MEMORY_MIN_SCORE=0.4

# ========= Embedding（BGE-M3，本地 sentence-transformers） =========
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# ========= 日志 =========
LOG_LEVEL=INFO
