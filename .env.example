# ========= 应用配置 =========
# 运行 profile：dev=本地降级（SQLite/Qdrant local mode/内存缓存，零容器） | prod=全量真实依赖
APP_PROFILE=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# ========= LLM（DeepSeek，OpenAI 兼容接口） =========
# 注意：deepseek-chat / deepseek-reasoner 旧别名已于 2026-07-24 退役，调用会报错
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-deepseek-api-key
# 主链路模型（意图识别/任务规划/工具调用/回答生成）
LLM_MODEL=deepseek-flash
# 图片 OCR 专职模型（失败自动降级 Mock，见 D008）
LLM_VISION_MODEL=deepseek-flash
# LLM 单价表（T177，D083 成本单位经济）："model:miss¥/M,hit¥/M,completion¥/M;..."
# 供应商调价只改此配置；默认对齐项目叙事口径（DeepSeek 命中价为 miss 的 1/10）
LLM_PRICING=deepseek-flash:2.0,0.2,3.0

# ========= PostgreSQL（prod profile 使用；dev 自动降级 SQLite） =========
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=claim
POSTGRES_PASSWORD=claimpass
POSTGRES_DB=claim_agent

# ========= LangGraph checkpoint 后端（T155 多实例，D071） =========
# auto=按 profile（dev=memory / prod=postgres）；sqlite=共享 checkpoint 文件。
# **dev 起多实例（多端口/多进程共享同一 data 目录）必须设 sqlite**：
# 默认 memory 各实例内存隔离，他实例认领 RESUME 任务后找不到 checkpoint，
# 版本门卫会误判降级全新重跑、人工决议蒸发（T145 实锤）
#CHECKPOINT_BACKEND=auto
#CHECKPOINT_SQLITE_PATH=./data/checkpoints.sqlite

# ========= 交付队列多实例租约（T155，D071） =========
# 认领租约时长（秒）：执行期每 ttl/3 心跳续租；实例崩溃后租约到期即可被
# 其他实例接管。须明显大于单案最长执行时长（默认 120s 覆盖 ~140 案/分钟档位）
#CASE_JOBS_LEASE_TTL_S=120

# ========= Qdrant =========
# prod：连接 Qdrant 服务；dev：使用 local mode 本地文件（零容器）
QDRANT_URL=http://localhost:6333
QDRANT_LOCAL_PATH=./data/qdrant
QDRANT_COLLECTION=claim_rules

# ========= 重排序精排（T043，D020） =========
# 开关默认关（小语料收益趋近于零，语料扩大后开启）；bge-reranker-v2-m3 与 BGE-M3 同生态
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu
# torch（默认稳定）| onnx（INT8 动态量化约 200MB，首次启用自动导出）
RERANK_BACKEND=torch
# 精排流水线：先召回 RERANK_RECALL_K 条 → 重排 → 取 RERANK_TOP_K 条
RERANK_RECALL_K=8
RERANK_TOP_K=4

# ========= Redis（prod profile 使用；dev 自动降级内存缓存） =========
REDIS_URL=redis://localhost:6379/0

# ========= 工具结果缓存（T028） =========
# 幂等查询工具的结果缓存：prod=Redis / dev=进程内 TTL 字典
TOOL_CACHE_ENABLED=true
TOOL_CACHE_TTL_SECONDS=300
# 白名单（逗号分隔）：仅纯读查询工具（工厂注册名），计算类/合规类不入缓存
TOOL_CACHE_TOOLS=policy_query,record_query,diagnosis_matcher,claim_rule_rag

# ========= 材料上传（T049：PDF/Word 支持，D024） =========
# 上传大小上限（MB）
MATERIAL_MAX_SIZE_MB=10
# 扫描件 PDF 最多渲染页数（走 vision OCR）
MATERIAL_PDF_RENDER_PAGES=3
# PDF 抽取文本低于该字符数视为扫描件（转渲染走 vision）
MATERIAL_PDF_TEXT_MIN_CHARS=50

# ========= 轮次 Token 预算（T029） =========
# 单轮对话总 token 上限；超限输出告警日志（不阻断）。0=不设预算
TURN_TOKEN_BUDGET=0

# ========= 跨供应商 A/B 变体（T041） =========
# GLM（智谱）OpenAI 兼容接口；glm-5.3-flash 变体经 $glm_api_key 间接引用
# GLM_API_KEY=
GLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ========= OTel 追踪（T039） =========
# 开关：true 时 OTLP 上报（需先起 tracing 栈：docker compose --profile tracing up -d）
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
# 采样率 0.0-1.0（ParentBased(TraceIdRatioBased)）；T166 起默认 0.2——
# 全采样下每请求数十 span，磁盘/CPU 成本高；排障只需 trace_id 级定位
OTEL_SAMPLING_RATIO=0.2

# ========= 长期记忆（T034/T035；T048 起存储为 LangGraph Store） =========
# 会话摘要 + 关键实体向量化入官方 Store（dev=InMemoryStore / prod=AsyncPostgresStore，
# namespace 按 user_id 隔离，向量 index 用 BGE-M3 1024 维）
MEMORY_ENABLED=true

# ========= 记忆治理（T138，D055-3） =========
# 写入门控：终态链路置信度低于该值的档案不写入（防低置信档案污染）
MEMORY_CONFIDENCE_FLOOR=0.6
# 档案 TTL（天）；0=永不过期（应用层 expires_at 惰性过期）
MEMORY_TTL_DAYS=365

# ========= Embedding（BGE-M3，本地 sentence-transformers） =========
EMBEDDING_MODEL=BAAI/bge-m3
# 本地模型目录（可选，优先于 EMBEDDING_MODEL）：容器/离线直载快照目录，
# 绕开 hub 在线版本检查（Windows 拷入的缓存快照在 Linux 会被 hub 判为无效缓存）
# EMBEDDING_MODEL_PATH=
EMBEDDING_DEVICE=cpu
# 模型已入本地缓存（~/.cache/huggingface）后置 1：跳过 HuggingFace 在线版本检查，
# 网络不可达时该检查会超时重试拖慢启动；首次下载模型时须保持 0
HF_OFFLINE=0

# ========= 门户客服（D057） =========
# Agent 多轮记忆 replay 窗口（送入 LLM 的最近消息条数，超出截断）
SUPPORT_HISTORY_WINDOW=20

# ========= 坐席端点鉴权（T147，D067 路径 A） =========
# 格式 "名字:Key,名字:Key"；空 = 不校验（dev 默认，坐席身份回退请求体自报）
# 请求头 X-Staff-Key 携带 Key；prod 启动强制非空
# STAFF_KEYS=alice:请换强随机Key,bob:另一个强随机Key

# ========= 门户限流（T172，D078 自研令牌桶） =========
# 每分钟配额（按客户端 IP；容量=配额、配额/60 每秒回填）；0 = 不限流
# 负载测试：服务器侧置 RATE_LIMIT_CASES_PER_MIN=0 后再压测
RATE_LIMIT_CASES_PER_MIN=30
RATE_LIMIT_SUPPORT_PER_MIN=60
# 是否信任 X-Forwarded-For 首跳为真实客户端 IP（默认 False：直连场景该头可伪造
# 轮转键绕过限流；仅确认前方有可信反向代理时开启）
RATE_LIMIT_TRUST_FORWARDED=false

# ========= 日志 =========
LOG_LEVEL=INFO
# 日志零 PII（T175，D081）：structlog 事件字段递归脱敏（身份证/银行卡/手机号）；
# 排障需要原文时临时置 false，勿长期关闭
LOG_MASK_PII=true

# ========= PII 库内加密（T176，D082） =========
# 证件号列（policies.holder_id_card / medical_records.patient_id_card）确定性 AES 密钥；
# 空 = dev 固定开发密钥（密文不具保密性）；prod 强制非空（启动校验）
# PII_ENCRYPTION_KEY=请换强随机密钥

# ===== 核赔分级自动（Phase 8，D037/D039；均有默认值，按需覆盖） =====
# AUTO_APPROVE_LIMIT=5000.00
# ORCHESTRATOR_LLM_ENABLED=true
# MATERIAL_REVIEW_LLM_ENABLED=true
# CASE_MATERIALS_DIR=./data/uploads
