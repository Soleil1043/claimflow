      "title": "Prompt 缓存命中率",
      "description": "DeepSeek 硬盘缓存命中 token 占比。命中率越高，本次调用实际计费越低（命中价约为 miss 价的 1/10）。",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(claimflow_llm_cache_tokens_total{result=\"hit\"}[$__range])) / (sum(increase(claimflow_llm_cache_tokens_total{result=\"hit\"}[$__range])) + sum(increase(claimflow_llm_cache_tokens_total{result=\"miss\"}[$__range])))",
          "legendFormat": "命中率"
        }
      ]
    },
