  "cards": [
    {
      "dot": "cyan",
      "title": "三条执行路径",
      "items": [
        "意图识别分流：多步任务 / 简单 FAQ / 单域与闲聊",
        "多步路径由 planner 规划，step_executor 循环调度 Worker Agent"
      ]
    },
    {
      "dot": "rose",
      "title": "合规一票否决",
      "items": [
        "所有输出路径必经 compliance 审查，条件边保证无旁路出口",
        "MODIFY 自动修订并复审（上限 2 轮），REJECT 直接拦截"
      ]
    },
    {
      "dot": "amber",
      "title": "人工介入闭环",
      "items": [
        "REJECT 触发 interrupt 挂起，坐席结论回写后仍需合规复审",
        "挂起状态随 checkpoint 持久化，服务重启后可恢复"
      ]
    }
  ]
